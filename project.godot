; Engine configuration file for Miner Mania 3D (Godot 4.7).
;
; The generated asset library (assets/generated, built by
; `blender --background --python blender/build.py`) is imported here; the
; scene import default script sets clip loop modes from the manifest.
; Pipeline sources, tools, docs, manifests and reports carry a .gdignore so
; Godot never imports them.

config_version=5

[application]

config/name="Miner Mania 3D"
config/description="3D mobile mining tycoon: dig deeper, automate everything, build a mining empire."
config/version="1.0.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.086, 0.078, 0.071, 1)
boot_splash/show_image=false
config/icon="res://game/ui/icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

EventBus="*res://game/autoload/event_bus.gd"
Telemetry="*res://game/autoload/telemetry.gd"
Settings="*res://game/autoload/settings.gd"
GameState="*res://game/autoload/game_state.gd"
Assets="*res://game/autoload/assets.gd"
Audio="*res://game/autoload/audio.gd"
SaveService="*res://game/autoload/save_service.gd"
Session="*res://game/autoload/session.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true
window/frame_pacing/android/enable_frame_pacing=true
window/frame_pacing/android/enable_frame_pacing.x86_64=false

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 0,
"mipmaps/generate": true,
"process/size_limit": 1024
}
scene={
"import_script/path": "res://godot/pipeline/asset_post_import.gd"
}
wav={
"compress/mode": 2
}

[input_devices]

buffering/agile_event_flushing=true
pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.086, 0.078, 0.071, 1)
