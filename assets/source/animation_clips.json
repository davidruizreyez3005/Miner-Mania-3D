{
  "_comment": "Contract for the shared worker animation library. Generators must produce every clip listed here; validators enforce loop, contact, grip and root-motion rules after GLB export.",
  "skeleton": "humanoid_worker_v1",
  "fps": 30,
  "grips": {
    "pickaxe":  {"socket": "hand_tool.L", "relative_to": "hand_tool.R", "offset": [0.0, -0.30, 0.0], "rotation_deg": [0.0, 0.0, 0.0]},
    "shovel":   {"socket": "hand_tool.L", "relative_to": "hand_tool.R", "offset": [0.0, -0.40, 0.0], "rotation_deg": [0.0, 180.0, 0.0]},
    "jackhammer": {"socket": "hand_tool.L", "relative_to": "hand_tool.R", "offset": [0.0, 0.36, 0.0], "rotation_deg": [0.0, 0.0, 180.0]},
    "carry_box": {"socket_pair": ["hand_tool.L", "hand_tool.R"], "relative_to": "carry_attachment", "offsets": [[0.255, 0.20, 0.0], [-0.255, 0.20, 0.0]]},
    "cart_bar": {"socket_pair": ["hand_tool.L", "hand_tool.R"], "relative_to": "root", "offsets": [[0.22, -0.56, 0.98], [-0.22, -0.56, 0.98]]},
    "pull_bar": {"socket_pair": ["hand_tool.L", "hand_tool.R"], "relative_to": "root", "offsets": [[0.2, -0.5, 0.92], [-0.2, -0.5, 0.92]]}
  },
  "interaction_points": {
    "_comment": "Standard interaction layout, relative to the worker root (Blender space, worker faces -Y). Machines place socket_* nodes so these points land on their controls.",
    "operate_levers": [[0.17, -0.46, 1.02], [-0.17, -0.46, 1.02]],
    "button": [0.0, -0.5, 1.12],
    "repair_bolt": [0.05, -0.55, 0.52],
    "hammer_surface": [-0.05, -0.55, 1.05],
    "load_surface": [0.0, -0.62, 1.0],
    "lever_handle_top": [-0.1, -0.42, 1.55],
    "seat_height": 0.46
  },
  "clips": {
    "Idle":          {"loop": true,  "duration": 3.0, "feet": "planted",    "root_motion": {"type": "none"}},
    "Idle_Variant":  {"loop": false, "duration": 4.0, "feet": "planted",    "root_motion": {"type": "none"}},
    "Walk":          {"loop": true,  "duration": 1.0, "feet": "locomotion", "root_motion": {"type": "in_place", "speed_mps": 1.4}},
    "Run":           {"loop": true,  "duration": 0.7, "feet": "locomotion", "root_motion": {"type": "in_place", "speed_mps": 3.6}},
    "Turn_Left":     {"loop": false, "duration": 1.0, "feet": "stepping",   "root_motion": {"type": "rotation", "degrees": 90.0}},
    "Turn_Right":    {"loop": false, "duration": 1.0, "feet": "stepping",   "root_motion": {"type": "rotation", "degrees": -90.0}},
    "Mine":          {"loop": true,  "duration": 1.6, "feet": "planted",    "root_motion": {"type": "none"}, "tool": "pickaxe", "grip": "pickaxe", "events": {"impact": 0.8}},
    "Mine_Heavy":    {"loop": true,  "duration": 2.2, "feet": "planted",    "root_motion": {"type": "none"}, "tool": "pickaxe", "grip": "pickaxe", "events": {"impact": 1.2}},
    "Pick_Up":       {"loop": false, "duration": 1.6, "feet": "planted",    "root_motion": {"type": "none"}, "prop": "carry_box", "grip": "carry_box", "grip_window": [0.55, 1.6]},
    "Put_Down":      {"loop": false, "duration": 1.6, "feet": "planted",    "root_motion": {"type": "none"}, "prop": "carry_box", "grip": "carry_box", "grip_window": [0.0, 1.05]},
    "Carry":         {"loop": true,  "duration": 2.0, "feet": "planted",    "root_motion": {"type": "none"}, "prop": "carry_box", "grip": "carry_box"},
    "Carry_Walk":    {"loop": true,  "duration": 1.1, "feet": "locomotion", "root_motion": {"type": "in_place", "speed_mps": 1.1}, "prop": "carry_box", "grip": "carry_box"},
    "Load":          {"loop": false, "duration": 1.8, "feet": "planted",    "root_motion": {"type": "none"}, "prop": "carry_box", "grip": "carry_box", "grip_window": [0.0, 1.0], "interaction": "socket_load"},
    "Unload":        {"loop": false, "duration": 1.8, "feet": "planted",    "root_motion": {"type": "none"}, "prop": "carry_box", "grip": "carry_box", "grip_window": [0.8, 1.8], "interaction": "socket_load"},
    "Operate":       {"loop": true,  "duration": 2.4, "feet": "planted",    "root_motion": {"type": "none"}, "interaction": "socket_operate"},
    "Repair":        {"loop": true,  "duration": 2.0, "feet": "kneel",      "root_motion": {"type": "none"}, "tool": "wrench", "interaction": "socket_repair"},
    "Hammer":        {"loop": true,  "duration": 1.0, "feet": "planted",    "root_motion": {"type": "none"}, "tool": "hammer", "events": {"impact": 0.45}},
    "Drill":         {"loop": true,  "duration": 1.2, "feet": "planted",    "root_motion": {"type": "none"}, "tool": "jackhammer", "grip": "jackhammer"},
    "Dig":           {"loop": true,  "duration": 2.0, "feet": "planted",    "root_motion": {"type": "none"}, "tool": "shovel", "grip": "shovel", "events": {"dig": 0.55, "toss": 1.45}},
    "Push":          {"loop": true,  "duration": 1.2, "feet": "locomotion", "root_motion": {"type": "in_place", "speed_mps": 0.85}, "grip": "cart_bar"},
    "Pull":          {"loop": true,  "duration": 1.4, "feet": "locomotion", "root_motion": {"type": "in_place", "speed_mps": -0.6}, "grip": "pull_bar"},
    "Celebrate":     {"loop": false, "duration": 2.0, "feet": "free",       "root_motion": {"type": "none"}},
    "React":         {"loop": false, "duration": 1.1, "feet": "stepping",   "root_motion": {"type": "none"}},
    "Rest":          {"loop": true,  "duration": 3.0, "feet": "planted",    "root_motion": {"type": "none"}},
    "Sit":           {"loop": true,  "duration": 3.0, "feet": "planted",    "root_motion": {"type": "none"}, "interaction": "seat"},
    "Death_or_Fall": {"loop": false, "duration": 1.8, "feet": "free",       "root_motion": {"type": "none"}},
    "Interact":      {"loop": false, "duration": 1.2, "feet": "planted",    "root_motion": {"type": "none"}, "interaction": "button"},
    "Inspect":       {"loop": true,  "duration": 3.2, "feet": "planted",    "root_motion": {"type": "none"}, "optional": true},
    "Pull_Lever":    {"loop": false, "duration": 1.6, "feet": "planted",    "root_motion": {"type": "none"}, "interaction": "lever", "optional": true}
  }
}
